# Python (server/)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Local / generated
# Every .env variant, not just the bare name. `.env` alone did not match
# `.env.local-testing`, which reached a public branch carrying the live
# relay key and dashboard password. A filename is a bad place for the
# only thing standing between a secret and a git push.
.env
.env.*
!.env.example
*.md.bak

# The relay's reflection archive — a location history, and local data by
# definition. Back it up off the host; don't commit it.
*.sqlite3
*.sqlite3-journal

# Arduino
*.hex
*.bin
build/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local credentials — real values only, never committed.
# Copy Flipee/secrets.example.h to Flipee/secrets.h and fill it in.
Flipee/secrets.h

# Claude Code local machine settings
.claude/settings.local.json
