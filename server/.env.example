# Copy this file to .env and fill in values.
#   copy .env.example .env
# .env is gitignored and loaded automatically on startup.

ANTHROPIC_API_KEY=

# Long random shared secret — Flipee.ino's RELAY_KEY must match this exactly.
# /reflect refuses all requests (503) until this is set, so it never runs
# open once it's reachable from the internet.
FLIPEE_RELAY_KEY=

# Long random password for the web dashboard at http://<host>:5024/.
# Deliberately NOT the same value as FLIPEE_RELAY_KEY: that one is compiled
# into the sketch and travels with the hardware, and it shouldn't also
# unlock the archive of where the device has been. The dashboard refuses
# all requests (503) until this is set. Reflections are archived either
# way, so setting it later loses nothing.
FLIPEE_DASHBOARD_KEY=

# Set to 1 once there's TLS in front of this (nginx/certbot on a VPS) so
# the dashboard's session cookie is marked Secure. Leave unset for plain
# HTTP same-LAN testing — a Secure cookie is never sent over HTTP, which
# makes login look like it silently fails.
# FLIPEE_DASHBOARD_HTTPS=1

# Optional. Defaults to 5024 — pick anything free on your host.
# FLIPEE_RELAY_PORT=5024

# --- Which model writes the live reflections -------------------------
# "anthropic" (default) or "ollama-cloud". Only affects /reflect; the
# archivist's rewrite stays on Claude, where latency is free and prose
# quality is the only thing that matters.
# REFLECTION_BACKEND=ollama-cloud
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=kimi-k2.5:cloud
#
# Seconds to wait before giving up on Ollama. This is a SHARED budget,
# not a local choice: the device waits RELAY_TIMEOUT_MS (15s) and then
# writes its own templated reflection, so this plus the Anthropic
# fallback (~4.5s measured) has to fit inside that. Much past 9 and the
# fallback still runs but arrives too late to be used — which looks
# exactly like the fallback not working.
# OLLAMA_TIMEOUT=7
#
# Fall back to Anthropic when Ollama fails. Turning this off means a
# failed Ollama call returns 500 and the device writes a template.
# ANTHROPIC_FALLBACK=true

# Where the reflection archive lives. Defaults to flipee.sqlite3 next to
# flipee_relay.py — point this somewhere persistent if the checkout gets
# replaced on deploy.
# FLIPEE_DB_PATH=/var/lib/flipee/flipee.sqlite3
